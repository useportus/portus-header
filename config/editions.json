      "excluded_pro_modules": [
        "woocommerce_instant_search",
        "advanced_search_history_recent_highlight",
        "woocommerce_account_dropdown",
        "woocommerce_bag_counter",
        "mega_menu",
        "smart_header",
        "advanced_presets",
        "import_export",
        "private_updater",
        "license_key",
        "menu_item_badges_icons_visibility"
      ]
    },
    "pro": {
      "status": "current",
      "buildable": true,
      "name": "Portus Header Pro",
      "slug": "portus-header-pro",
      "plugin_dir": "portus-header/",
      "distribution": "private zip",
      "license_target": "commercial private distribution; GPL compatibility to be finalized before public sale",
      "positioning": "Header avançado para Portus e clientes pagantes, com WooCommerce, mega menu, busca e painel profissional.",
      "features": [
        "all_free_features",
        "woocommerce_instant_search",
        "advanced_search_history_recent_highlight",
        "woocommerce_account_dropdown",
        "woocommerce_bag_counter",
        "mega_menu",
        "smart_header",
        "advanced_presets",
        "import_export",
        "private_updater",
        "license_key",
        "menu_item_badges_icons_visibility"
      ]
    }
  },
  "build_context": {
    "edition": "free",
    "candidate": true
  }
}
