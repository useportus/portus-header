    "service_paths": {
      "pro_woocommerce_search": "includes/Pro/WooCommerce/class-portus-header-product-search.php",
      "pro_mega_menu": "includes/Pro/MegaMenu/class-portus-header-mega-menu.php",
      "pro_license_manager": "includes/Pro/Licensing/class-portus-header-license-manager.php",
      "pro_licensing_updater": "includes/Pro/Licensing/class-portus-header-updater.php"
