      "distribution": "wordpress.org candidate",
      "license_target": "GPL-2.0-or-later compatible",
      "positioning": "Header responsivo essencial para WordPress, sem dependência de builders premium.",
      "allowed_features": [
        "header_responsive",
        "native_wp_menu",
        "desktop_mobile_logo",
        "basic_cta",
        "automatic_or_shortcode_mode",
        "page_inclusion_exclusion",
        "sticky_header",
        "basic_colors",
        "basic_mobile_drawer",
        "local_svg_assets"
