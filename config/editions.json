        "templates/account-dropdown.php",
        "templates/mini-cart.php",
        "templates/search-panel.php",
        "assets/css/portus-header-pro.css",
        "assets/js/portus-header-pro.js",
        "assets/images/portus-header/banner-772x250.png",
        "assets/images/portus-header/banner-1544x500.png",
        "assets/images/portus-header/hero-portus-header-pro.png",
        "assets/images/portus-header/product-cover-portus-header-pro.png",
        "readme-pro.txt",
        "docs",
        "docs/BRANDING.md",
        "docs/PRO-DISTRIBUTION.md",
        "docs/PRO-STORE-LISTING.md",
        "docs/CUSTOMER-GUIDE.md",
        "docs/PRO-RELEASE-2.3.3.md",
        "docs/PRO-RELEASE-2.3.4.md",
        "docs/PRO-RELEASE-2.3.8.md",
        "docs/PRO-RELEASE-2.3.9.md",
        "docs/PRO-RELEASE-CHECKLIST.md",
        "docs/SUPPORT-UPDATE-POLICY.md"
      ]
    }
