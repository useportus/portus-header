      "customer_guide": "docs/CUSTOMER-GUIDE.md",
      "release_notes": "docs/PRO-RELEASE-2.3.9.md",
      "release_checklist": "docs/PRO-RELEASE-CHECKLIST.md",
      "support_update_policy": "docs/SUPPORT-UPDATE-POLICY.md"
