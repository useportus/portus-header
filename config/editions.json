{
  "schema": 1,
  "current_edition": "free",
  "notes": "A edição Free está planejada, mas ainda não deve ser gerada para distribuição. A edição Pro é o produto privado atual.",
  "architecture": {
    "stage": "2.3.9",
    "module_paths": {
      "core": "includes/Core",
      "free": "includes/Free",
      "pro": "includes/Pro",
      "pro_admin": "includes/Pro/Admin",
      "pro_woocommerce": "includes/Pro/WooCommerce",
      "pro_mega_menu": "includes/Pro/MegaMenu",
      "pro_licensing": "includes/Pro/Licensing"
    },
    "template_paths": {
      "free": "templates/free",
      "pro": "templates/pro",
      "compatibility_wrappers": "templates"
    },
    "settings_groups": {
      "free": [
        "display",
        "logos",
        "cta",
        "basic_colors",
        "basic_mobile_drawer",
        "basic_dimensions",
        "theme_compatibility"
      ],
      "pro": [
        "woocommerce_search_account_cart",
        "advanced_search_results",
        "mega_menu",
        "smart_header",
        "advanced_presets",
        "import_export",
        "private_updater_license"
      ]
    },
    "settings_schema_paths": {
